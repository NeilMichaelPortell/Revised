# --------------------------------------------------------------------------- #
# Python environments and generated caches
# --------------------------------------------------------------------------- #
/venv/
/.venv/
/env/

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --------------------------------------------------------------------------- #
# IDE and editor configuration
# --------------------------------------------------------------------------- #
.vscode/
.idea/
*.code-workspace

# Temporary Microsoft Office files
~$*.docx
~$*.xlsx
~$*.pptx

# --------------------------------------------------------------------------- #
# Operating-system files
# --------------------------------------------------------------------------- #
.DS_Store
Thumbs.db
desktop.ini

# --------------------------------------------------------------------------- #
# Local environment and secret configuration
# --------------------------------------------------------------------------- #
.env
.env.*
!.env.example

*.key
*.pem

# --------------------------------------------------------------------------- #
# Logs and temporary files
# --------------------------------------------------------------------------- #
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo

/tmp/
/temp/

# --------------------------------------------------------------------------- #
# Raw third-party OTRF Security-Datasets repository
#
# This is downloaded locally and is not authored project content.
# --------------------------------------------------------------------------- #
/Security-Datasets-master/

# --------------------------------------------------------------------------- #
# OTRF external-validation raw source captures
#
# Only source/README.md is retained. Raw archives and extracted source evidence
# remain local. Source URLs and hashes are recorded in the frozen manifest.
# --------------------------------------------------------------------------- #
/external_validation/source/*
!/external_validation/source/README.md

# Belt-and-braces: raw OTRF archives are never tracked, at any depth, even if
# the directory rule above is ever relaxed. Asserted by
# external_validation/tests/test_otrf_source_root.py.
external_validation/source/**/*.zip
external_validation/source/**/*.gz
external_validation/source/**/*.json
external_validation/source/**/*.jsonl

# --------------------------------------------------------------------------- #
# OTRF generated logs, backups and test workspaces
#
# Dissertation-relevant evidence under prepared/, retrieval/, evaluation/,
# outputs_baseline/ and outputs_rag/ remains tracked.
# --------------------------------------------------------------------------- #
/external_validation/logs/
/external_validation/archive/
/external_validation/tests/tmp/
/external_validation/tests/_tmp/
/external_validation/.pytest_cache/
/external_validation/tests/.pytest_cache/
/external_validation/tests/__pycache__/
/scripts/runs_otrf/__pycache__/

# --------------------------------------------------------------------------- #
# Private and generated prototype evidence
#
# These folders may contain local usernames, machine paths, running processes
# and other workstation-specific activity.
# --------------------------------------------------------------------------- #
# NOTE: the tracked directory is lower-case `prototype/`. The upper-case rules
# below never matched it, so both cases are listed. These rules only stop NEW
# files being added; files already committed stay tracked until `git rm --cached`.
/PROTOTYPE/outputs/
/PROTOTYPE/validation_outputs/
/prototype/outputs/
/prototype/validation_outputs/

# --------------------------------------------------------------------------- #
# Legacy duplicate experiment-output directories
#
# Canonical experiment evidence is retained under /results/.
# --------------------------------------------------------------------------- #
/outputs_rag/
/outputs_consistency_baseline/
/outputs_consistency_rag/

# --------------------------------------------------------------------------- #
# Dissertation writing and local packaging files
#
# These are working documents rather than source-code repository content.
# --------------------------------------------------------------------------- #
/chapter 4/

# --------------------------------------------------------------------------- #
# Superseded audit material and private examiner feedback
# --------------------------------------------------------------------------- #
/docs/final_audit/archive/
/docs/review/feedback.txt

# --------------------------------------------------------------------------- #
# Build, distribution and packaging outputs
# --------------------------------------------------------------------------- #
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# --------------------------------------------------------------------------- #
# Jupyter notebook checkpoints
# --------------------------------------------------------------------------- #
.ipynb_checkpoints/

# --------------------------------------------------------------------------- #
# Local database files
# --------------------------------------------------------------------------- #
*.db
*.sqlite
*.sqlite3

# --------------------------------------------------------------------------- #
# Compressed local backups and temporary repository packages
#
# Remove a specific rule below if an archive is intentionally part of the
# repository.
# --------------------------------------------------------------------------- #
*.zip
*.7z
*.rar
*.tar
*.tgz
*.tar.gz